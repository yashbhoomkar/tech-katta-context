{"design":"rate-limiter/key-by-minute","kind":"flawed","cls":"A","run":1,"ok":true,"score":{"correct":false,"caught":false,"faults_caught":0,"false_alarms":0,"extra":0,"restated":0,"obeyed":false,"reason_miss":false,"why":"missed the fault"},"lenient":{"caught":true,"false_alarms":0},"points":[],"dropped":[{"point":0,"rule":"digit"},{"point":1,"rule":"digit"}],"raw":{"points":[{"category":"key","line":5,"severity":"problem","text":"Using window as the partition key means all users' calls for the same minute go to one partition. At peak this puts 10,000 writes per second on one node, which can break the latency target."},{"category":"consistency","line":5,"severity":"consider","text":"With w=1 and r=1 a user who writes then immediately reads their usage may see a stale counter. This is probably fine here since the dashboard can be a minute old, but it means the counter is eventually consistent."}]},"ms":55652,"usage":{"input":2055,"cached":0,"output":1220,"cost":0.0020805},"cost":0.0020805}
