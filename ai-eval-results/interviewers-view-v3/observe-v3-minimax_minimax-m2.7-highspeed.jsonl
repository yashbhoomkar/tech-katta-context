{"design":"chat-message-store/key-by-message","kind":"flawed","cls":"A","run":1,"ok":true,"score":{"correct":false,"caught":false,"faults_caught":0,"false_alarms":0,"extra":0,"restated":0,"obeyed":false,"reason_miss":false,"why":"missed the fault"},"lenient":{"caught":false,"false_alarms":0},"points":[],"dropped":[{"point":0,"rule":"text"}],"raw":{"points":[{"category":"key","line":6,"severity":"problem","text":"Using message_id as the partition key scatters each chat's messages across many nodes. To read a chat you must query every node, sort, and trim. With crores of messages this is slow and expensive. Use chat_id as the partition key so all messages of one chat live on the same nodes and a range query returns them directly."}]},"ms":90658,"usage":{"input":2079,"cached":1986,"output":805,"cost":0.00210696},"cost":0.00210696}
{"design":"news-feed/key-by-region","kind":"flawed","cls":"A","run":1,"ok":true,"score":{"correct":false,"caught":false,"faults_caught":0,"false_alarms":0,"extra":0,"restated":0,"obeyed":false,"reason_miss":false,"why":"missed the fault"},"lenient":{"caught":false,"false_alarms":0},"points":[],"dropped":[{"point":0,"rule":"text"}],"raw":{"points":[{"category":"key","line":7,"severity":"problem","text":"The partition key is region but a feed belongs to one user and is read by that user's id. Region partitions also scatter the feeds of users who follow each other, so a post's fan-out to followers' feeds cannot route to the right partition without a separate lookup step that is not shown."}]},"ms":55190,"usage":{"input":2100,"cached":2017,"output":1575,"cost":0.00395082},"cost":0.00395082}
